{
  "name": "stripboard",
  "private": true,
  "version": "0.1.0",
  "description": "Automatic stripboard (Veroboard) layout optimiser: placement, track cuts and wire links.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/smoke.cjs",
    "bench": "BENCH=1 vitest run tests/bench.test.ts --silent=false"
  },
  "dependencies": {
    "clingo-wasm": "0.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
